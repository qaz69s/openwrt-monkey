#!/usr/bin/utpl

{%-
	'use strict';

	import { readfile } from 'fs';
	import { cursor } from 'uci';
	import { connect } from 'ubus';
	import { uci_bool, uci_array } from '/etc/monkey/ucode/include.uc';

	const fw4 = require('fw4');
	const uci = cursor();
	const ubus = connect();

	uci.load('monkey');

	// ── 从 config.yaml 读取端口 ──
	let tproxy_port;
	let dns_port;
	let tun_name;

	const config_content = readfile('/etc/monkey/run/config.yaml');
	if (config_content) {
		let in_dns = false;
		let in_tun = false;
		for (let line in split(config_content, '\n')) {
			let l = trim(line);
			if (l == '') continue;

			if (l[0] != ' ') {
				in_dns = false; in_tun = false;
				let m = match(l, '^([a-zA-Z0-9_-]+):\\s*(.*)');
				if (m) {
					let k = trim(m[1]), v = trim(m[2]);
					if (k == 'tproxy-port') tproxy_port = v;
					if (k == 'dns') in_dns = true;
					if (k == 'tun') in_tun = true;
				}
				continue;
			}

			if (in_dns) {
				let m = match(l, '^\\s*listen:\\s*(.*)');
				if (m) {
					let listen = trim(m[1]).replace(/"/g, '');
					let idx = rindex(listen, ':');
					if (idx >= 0) dns_port = substr(listen, idx + 1);
				}
			}

			if (in_tun) {
				let m = match(l, '^\\s*device-name:\\s*(.*)');
				if (m) tun_name = trim(m[1]).replace(/"/g, '');
			}
		}
	}

	// fallback
	if (!tproxy_port) tproxy_port = uci.get('monkey', 'mixin', 'tproxy_port') || '7892';
	if (!dns_port) dns_port = uci.get('monkey', 'mixin', 'dns_port') || '5353';
	if (!tun_name) tun_name = uci.get('monkey', 'mixin', 'tun_name') || 'momo';

	const ipv4_dns_hijack = uci_bool(uci.get('monkey', 'proxy', 'ipv4_dns_hijack'));
	const ipv6_dns_hijack = uci_bool(uci.get('monkey', 'proxy', 'ipv6_dns_hijack'));
	const ipv4_proxy = uci_bool(uci.get('monkey', 'proxy', 'ipv4_proxy'));
	const ipv6_proxy = uci_bool(uci.get('monkey', 'proxy', 'ipv6_proxy'));
	const fake_ip_ping_hijack = uci_bool(uci.get('monkey', 'proxy', 'fake_ip_ping_hijack'));
	const tcp_mode = uci.get('monkey', 'proxy', 'tcp_mode');
	const udp_mode = uci.get('monkey', 'proxy', 'udp_mode');

	const router_proxy = uci_bool(uci.get('monkey', 'proxy', 'router_proxy'));
	const router_access_control = [];
	uci.foreach('monkey', 'router_access_control', (ac) => {
		ac['enabled'] = uci_bool(ac['enabled']);
		ac['user'] = uci_array(ac['user']);
		ac['group'] = uci_array(ac['group']);
		ac['cgroup'] = uci_array(ac['cgroup']);
		ac['proxy'] = uci_bool(ac['proxy']);
		ac['dns'] = uci_bool(ac['dns']);
		push(router_access_control, ac);
	});

	const lan_proxy = uci_bool(uci.get('monkey', 'proxy', 'lan_proxy'));
	const lan_inbound_interface = uci_array(uci.get('monkey', 'proxy', 'lan_inbound_interface'));
	const lan_inbound_device = [];
	for (let interface in lan_inbound_interface) {
		const status = ubus.call('network.interface', 'status', { 'interface': interface });
		const device = status?.l3_device ?? status?.device ?? '';
		if (device != '') push(lan_inbound_device, device);
	}
	const lan_access_control = [];
	uci.foreach('monkey', 'lan_access_control', (ac) => {
		ac['enabled'] = uci_bool(ac['enabled']);
		ac['ip'] = uci_array(ac['ip']);
		ac['ip6'] = uci_array(ac['ip6']);
		ac['mac'] = uci_array(ac['mac']);
		ac['proxy'] = uci_bool(ac['proxy']);
		ac['dns'] = uci_bool(ac['dns']);
		push(lan_access_control, ac);
	});

	const reserved_ip = uci_array(uci.get('monkey', 'proxy', 'reserved_ip'));
	const reserved_ip6 = uci_array(uci.get('monkey', 'proxy', 'reserved_ip6'));
	const bypass_china_mainland_ip = uci_bool(uci.get('monkey', 'proxy', 'bypass_china_mainland_ip'));
	const bypass_china_mainland_ip6 = uci_bool(uci.get('monkey', 'proxy', 'bypass_china_mainland_ip6'));
	const proxy_tcp_dport = split((uci.get('monkey', 'proxy', 'proxy_tcp_dport') ?? '0-65535'), ' ');
	const proxy_udp_dport = split((uci.get('monkey', 'proxy', 'proxy_udp_dport') ?? '0-65535'), ' ');
	const bypass_dscp = uci_array(uci.get('monkey', 'proxy', 'bypass_dscp'));
	const bypass_fwmark = [];
	for (let fwmark in uci_array(uci.get('monkey', 'proxy', 'bypass_fwmark'))) {
		let mark, mask = '0xFFFFFFFF';
		if (index(fwmark, '/') >= 0) {
			const parts = split(fwmark, '/');
			mark = parts[0]; mask = parts[1];
		} else {
			mark = fwmark;
		}
		push(bypass_fwmark, { mark: mark, mask: mask });
	}

	const tproxy_fw_mark = uci.get('monkey', 'routing', 'tproxy_fw_mark') ?? '0x80';
	const tproxy_fw_mask = uci.get('monkey', 'routing', 'tproxy_fw_mask') ?? '0xFF';
	const tproxy_fw_umask = fw4.hex(~tonumber(tproxy_fw_mask) & 0xFFFFFFFF);
	const tun_fw_mark = uci.get('monkey', 'routing', 'tun_fw_mark') ?? '0x81';
	const tun_fw_mask = uci.get('monkey', 'routing', 'tun_fw_mask') ?? '0xFF';
	const tun_fw_umask = fw4.hex(~tonumber(tun_fw_mask) & 0xFFFFFFFF);

	const dns_hijack_nfproto = [];
	if (ipv4_dns_hijack) push(dns_hijack_nfproto, 'ipv4');
	if (ipv6_dns_hijack) push(dns_hijack_nfproto, 'ipv6');

	const proxy_nfproto = [];
	if (ipv4_proxy) push(proxy_nfproto, 'ipv4');
	if (ipv6_proxy) push(proxy_nfproto, 'ipv6');

	const proxy_dport = [];
	for (let port in proxy_tcp_dport) push(proxy_dport, `tcp . ${port}`);
	for (let port in proxy_udp_dport) push(proxy_dport, `udp . ${port}`);

	const cgroup_name = uci.get('monkey', 'routing', 'cgroup_name') ?? 'monkey';
-%}

table inet monkey {
	{% if (length(dns_hijack_nfproto) > 0): %}
	set dns_hijack_nfproto {
		type nf_proto
		flags interval
		elements = { {{ join(', ', dns_hijack_nfproto) }} }
	}
	{% endif %}

	set proxy_nfproto {
		type nf_proto
		flags interval
		{% if (length(proxy_nfproto) > 0): %}
		elements = { {{ join(', ', proxy_nfproto) }} }
		{% endif %}
	}

	set reserved_ip {
		type ipv4_addr
		flags interval
		auto-merge
		{% if (length(reserved_ip) > 0): %}
		elements = { {{ join(', ', reserved_ip) }} }
		{% endif %}
	}

	set reserved_ip6 {
		type ipv6_addr
		flags interval
		auto-merge
		{% if (length(reserved_ip6) > 0): %}
		elements = { {{ join(', ', reserved_ip6) }} }
		{% endif %}
	}

	set lan_inbound_device {
		type ifname
		flags interval
		auto-merge
		{% if (length(lan_inbound_device) > 0): %}
		elements = { {{ join(', ', map(lan_inbound_device, (x) => `"${x}"`)) }} }
		{% endif %}
	}

	set china_ip {
		type ipv4_addr
		flags interval
	}

	set china_ip6 {
		type ipv6_addr
		flags interval
	}

	set proxy_dport {
		type inet_proto . inet_service
		flags interval
		auto-merge
		{% if (length(proxy_dport) > 0): %}
		elements = { {{ join(', ', proxy_dport) }} }
		{% endif %}
	}

	set bypass_dscp {
		type dscp
		flags interval
		auto-merge
		{% if (length(bypass_dscp) > 0): %}
		elements = { {{ join(', ', bypass_dscp) }} }
		{% endif %}
	}

	{% if (router_proxy): %}
	{% if (length(dns_hijack_nfproto) > 0): %}
	chain router_dns_hijack {
		{% for (let ac in router_access_control): %}
		{% if (ac['enabled']): %}
		{% if (length(ac['user']) == 0 && length(ac['group']) == 0 && length(ac['cgroup']) == 0): %}
		meta l4proto { tcp, udp } th dport 53 counter {% if (ac.dns == '1'): %} redirect to :{{ dns_port }} {% else %} return {% endif %}
		{% else %}
		{% if (length(ac['user']) > 0): %}
		meta l4proto { tcp, udp } meta skuid { {{ join(', ', ac['user']) }} } th dport 53 counter {% if (ac.dns == '1'): %} redirect to :{{ dns_port }} {% else %} return {% endif %}
		{% endif %}
		{% if (length(ac['group']) > 0): %}
		meta l4proto { tcp, udp } meta skgid { {{ join(', ', ac['group']) }} } th dport 53 counter {% if (ac.dns == '1'): %} redirect to :{{ dns_port }} {% else %} return {% endif %}
		{% endif %}
		{% if (length(ac['cgroup']) > 0): %}
		{% for (let cg in ac['cgroup']): %}
		meta l4proto { tcp, udp } socket cgroupv2 level {{ length(split(cg, '/')) }} "{{ cg }}" th dport 53 counter {% if (ac.dns == '1'): %} redirect to :{{ dns_port }} {% else %} return {% endif %}
		{% endfor %}
		{% endif %}
		{% endif %}
		{% endif %}
		{% endfor %}
	}
	{% endif %}

	{% if (tcp_mode == 'tproxy' || udp_mode == 'tproxy'): %}
	chain router_tproxy {
		{% for (let ac in router_access_control): %}
		{% if (ac['enabled']): %}
		{% if (length(ac['user']) == 0 && length(ac['group']) == 0 && length(ac['cgroup']) == 0): %}
		meta l4proto { tcp, udp } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tproxy_fw_umask }} | {{ tproxy_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% else %}
		{% if (length(ac['user']) > 0): %}
		meta l4proto { tcp, udp } meta skuid { {{ join(', ', ac['user']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tproxy_fw_umask }} | {{ tproxy_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% if (length(ac['group']) > 0): %}
		meta l4proto { tcp, udp } meta skgid { {{ join(', ', ac['group']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tproxy_fw_umask }} | {{ tproxy_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% if (length(ac['cgroup']) > 0): %}
		{% for (let cg in ac['cgroup']): %}
		meta l4proto { tcp, udp } socket cgroupv2 level {{ length(split(cg, '/')) }} "{{ cg }}" {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tproxy_fw_umask }} | {{ tproxy_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% endfor %}
		{% endif %}
		{% endif %}
		{% endif %}
		{% endfor %}
	}
	{% endif %}

	{% if (tcp_mode == 'tun' || udp_mode == 'tun'): %}
	chain router_tun {
		{% for (let ac in router_access_control): %}
		{% if (ac['enabled']): %}
		{% if (length(ac['user']) == 0 && length(ac['group']) == 0 && length(ac['cgroup']) == 0): %}
		meta l4proto { tcp, udp } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tun_fw_umask }} | {{ tun_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% else %}
		{% if (length(ac['user']) > 0): %}
		meta l4proto { tcp, udp } meta skuid { {{ join(', ', ac['user']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tun_fw_umask }} | {{ tun_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% if (length(ac['group']) > 0): %}
		meta l4proto { tcp, udp } meta skgid { {{ join(', ', ac['group']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tun_fw_umask }} | {{ tun_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% if (length(ac['cgroup']) > 0): %}
		{% for (let cg in ac['cgroup']): %}
		meta l4proto { tcp, udp } socket cgroupv2 level {{ length(split(cg, '/')) }} "{{ cg }}" {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tun_fw_umask }} | {{ tun_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% endfor %}
		{% endif %}
		{% endif %}
		{% endif %}
		{% endfor %}
	}
	{% endif %}
	{% endif %}

	{% if (lan_proxy): %}
	{% if (length(dns_hijack_nfproto) > 0): %}
	chain lan_dns_hijack {
		{% for (let ac in lan_access_control): %}
		{% if (ac['enabled']): %}
		{% if (length(ac['ip']) == 0 && length(ac['ip6']) == 0 && length(ac['mac']) == 0): %}
		meta l4proto { tcp, udp } th dport 53 counter {% if (ac.dns == '1'): %} redirect to :{{ dns_port }} {% else %} return {% endif %}
		{% else %}
		{% if (length(ac['ip']) > 0): %}
		meta l4proto { tcp, udp } ip saddr { {{ join(', ', ac['ip']) }} } th dport 53 counter {% if (ac.dns == '1'): %} redirect to :{{ dns_port }} {% else %} return {% endif %}
		{% endif %}
		{% if (length(ac['ip6']) > 0): %}
		meta l4proto { tcp, udp } ip6 saddr { {{ join(', ', ac['ip6']) }} } th dport 53 counter {% if (ac.dns == '1'): %} redirect to :{{ dns_port }} {% else %} return {% endif %}
		{% endif %}
		{% if (length(ac['mac']) > 0): %}
		meta l4proto { tcp, udp } ether saddr { {{ join(', ', ac['mac']) }} } th dport 53 counter {% if (ac.dns == '1'): %} redirect to :{{ dns_port }} {% else %} return {% endif %}
		{% endif %}
		{% endif %}
		{% endif %}
		{% endfor %}
	}
	{% endif %}

	{% if (tcp_mode == 'tproxy' || udp_mode == 'tproxy'): %}
	chain lan_tproxy {
		{% for (let ac in lan_access_control): %}
		{% if (ac['enabled']): %}
		{% if (length(ac['ip']) == 0 && length(ac['ip6']) == 0 && length(ac['mac']) == 0): %}
		meta l4proto { tcp, udp } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tproxy_fw_umask }} | {{ tproxy_fw_mark }} tproxy to :{{ tproxy_port }} counter accept {% else %} counter return {% endif %}
		{% else %}
		{% if (length(ac['ip']) > 0): %}
		meta l4proto { tcp, udp } ip saddr { {{ join(', ', ac['ip']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tproxy_fw_umask }} | {{ tproxy_fw_mark }} tproxy ip to :{{ tproxy_port }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% if (length(ac['ip6']) > 0): %}
		meta l4proto { tcp, udp } ip6 saddr { {{ join(', ', ac['ip6']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tproxy_fw_umask }} | {{ tproxy_fw_mark }} tproxy ip6 to :{{ tproxy_port }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% if (length(ac['mac']) > 0): %}
		meta l4proto { tcp, udp } ether saddr { {{ join(', ', ac['mac']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tproxy_fw_umask }} | {{ tproxy_fw_mark }} tproxy to :{{ tproxy_port }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% endif %}
		{% endif %}
		{% endfor %}
	}
	{% endif %}

	{% if (tcp_mode == 'tun' || udp_mode == 'tun'): %}
	chain lan_tun {
		{% for (let ac in lan_access_control): %}
		{% if (ac['enabled']): %}
		{% if (length(ac['ip']) == 0 && length(ac['ip6']) == 0 && length(ac['mac']) == 0): %}
		meta l4proto { tcp, udp } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tun_fw_umask }} | {{ tun_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% else %}
		{% if (length(ac['ip']) > 0): %}
		meta l4proto { tcp, udp } ip saddr { {{ join(', ', ac['ip']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tun_fw_umask }} | {{ tun_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% if (length(ac['ip6']) > 0): %}
		meta l4proto { tcp, udp } ip6 saddr { {{ join(', ', ac['ip6']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tun_fw_umask }} | {{ tun_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% if (length(ac['mac']) > 0): %}
		meta l4proto { tcp, udp } ether saddr { {{ join(', ', ac['mac']) }} } {% if (ac.proxy == '1'): %} meta mark set meta mark & {{ tun_fw_umask }} | {{ tun_fw_mark }} counter accept {% else %} counter return {% endif %}
		{% endif %}
		{% endif %}
		{% endif %}
		{% endfor %}
	}
	{% endif %}
	{% endif %}

	{% if (router_proxy): %}
	chain nat_output {
		type nat hook output priority filter; policy accept;
		socket cgroupv2 level 2 "services/{{ cgroup_name }}" counter return
		{% if (length(dns_hijack_nfproto) > 0): %}
		meta nfproto @dns_hijack_nfproto jump router_dns_hijack
		{% endif %}
		{% if (fake_ip_ping_hijack): %}
		{% if (length(reserved_ip) > 0): %}
		ip daddr @reserved_ip counter return
		{% endif %}
		{% if (length(reserved_ip6) > 0): %}
		ip6 daddr @reserved_ip6 counter return
		{% endif %}
		{% endif %}
	}

	chain mangle_output {
		type route hook output priority mangle; policy accept;
		socket cgroupv2 level 2 "services/{{ cgroup_name }}" counter return
		fib daddr type { local, broadcast, anycast, multicast } counter return
		ct direction reply counter return
		ip daddr @reserved_ip counter return
		ip6 daddr @reserved_ip6 counter return
		ip daddr @china_ip counter return
		ip6 daddr @china_ip6 counter return
		meta nfproto ipv4 meta l4proto . th dport != @proxy_dport counter return
		meta nfproto ipv6 meta l4proto . th dport != @proxy_dport counter return
		meta l4proto { tcp, udp } ip dscp @bypass_dscp counter return
		meta l4proto { tcp, udp } ip6 dscp @bypass_dscp counter return
		{% for (let fwmark in bypass_fwmark): %}
		meta mark & {{ fwmark.mask }} == {{ fwmark.mark }} counter return
		{% endfor %}
		{% if (length(dns_hijack_nfproto) > 0): %}
		meta nfproto @dns_hijack_nfproto meta l4proto { tcp, udp } th dport 53 counter return
		{% endif %}
		{% if (tcp_mode == 'tproxy'): %}
		meta nfproto @proxy_nfproto meta l4proto tcp jump router_tproxy
		{% elif (tcp_mode == 'tun'): %}
		meta nfproto @proxy_nfproto meta l4proto tcp jump router_tun
		{% endif %}
		{% if (udp_mode == 'tproxy'): %}
		meta nfproto @proxy_nfproto meta l4proto udp jump router_tproxy
		{% elif (udp_mode == 'tun'): %}
		meta nfproto @proxy_nfproto meta l4proto udp jump router_tun
		{% endif %}
	}

	chain mangle_prerouting_router {
		type filter hook prerouting priority mangle - 1; policy accept;
		{% if (tcp_mode == 'tproxy' || udp_mode == 'tproxy'): %}
		iifname lo meta l4proto { tcp, udp } meta mark & {{ tproxy_fw_mask }} == {{ tproxy_fw_mark }} tproxy to :{{ tproxy_port }} counter accept
		{% endif %}
		{% if (tcp_mode == 'tun' || udp_mode == 'tun'): %}
		iifname "{{ tun_name }}" meta l4proto { icmp, tcp, udp } counter accept
		{% endif %}
	}
	{% endif %}

	{% if (lan_proxy): %}
	chain dstnat {
		type nat hook prerouting priority dstnat + 1; policy accept;
		{% if (length(dns_hijack_nfproto) > 0): %}
		iifname @lan_inbound_device meta nfproto @dns_hijack_nfproto jump lan_dns_hijack
		{% endif %}
	}

	chain mangle_prerouting_lan {
		type filter hook prerouting priority mangle; policy accept;
		fib daddr type { local, broadcast, anycast, multicast } counter return
		ct direction reply counter return
		ip daddr @reserved_ip counter return
		ip6 daddr @reserved_ip6 counter return
		ip daddr @china_ip counter return
		ip6 daddr @china_ip6 counter return
		meta nfproto ipv4 meta l4proto . th dport != @proxy_dport counter return
		meta nfproto ipv6 meta l4proto . th dport != @proxy_dport counter return
		meta l4proto { tcp, udp } ip dscp @bypass_dscp counter return
		meta l4proto { tcp, udp } ip6 dscp @bypass_dscp counter return
		{% for (let fwmark in bypass_fwmark): %}
		meta mark & {{ fwmark.mask }} == {{ fwmark.mark }} counter return
		{% endfor %}
		{% if (length(dns_hijack_nfproto) > 0): %}
		meta nfproto @dns_hijack_nfproto meta l4proto { tcp, udp } th dport 53 counter return
		{% endif %}
		{% if (tcp_mode == 'tproxy'): %}
		iifname @lan_inbound_device meta nfproto @proxy_nfproto meta l4proto tcp jump lan_tproxy
		{% elif (tcp_mode == 'tun'): %}
		iifname @lan_inbound_device meta nfproto @proxy_nfproto meta l4proto tcp jump lan_tun
		{% endif %}
		{% if (udp_mode == 'tproxy'): %}
		iifname @lan_inbound_device meta nfproto @proxy_nfproto meta l4proto udp jump lan_tproxy
		{% elif (udp_mode == 'tun'): %}
		iifname @lan_inbound_device meta nfproto @proxy_nfproto meta l4proto udp jump lan_tun
		{% endif %}
	}
	{% endif %}
}

{% if (bypass_china_mainland_ip): %}
include "/etc/monkey/nftables/geoip_cn.nft"
{% endif %}
{% if (bypass_china_mainland_ip6): %}
include "/etc/monkey/nftables/geoip6_cn.nft"
{% endif %}
