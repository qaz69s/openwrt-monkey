{
    "luci-app-monkey": {
        "description": "Grant access to monkey procedures",
        "read": {
            "uci": [ "monkey" ],
            "ubus": {
                "rc": [ "*" ],
                "luci.monkey": [ "*" ]
            },
            "file": {
                "/etc/monkey/run/config.yaml": ["read"],
                "/var/log/monkey/*.log": ["read"]
            }
        },
        "write": {
            "uci": [ "monkey" ],
            "ubus": {
                "uci": [ "set", "commit", "apply", "confirm", "rollback" ],
                "rc": [ "*" ],
                "luci.monkey": [ "*" ]
            },
            "file": {
                "/etc/monkey/run/config.yaml": ["write"],
                "/var/log/monkey/*.log": ["write"],
                "/etc/init.d/monkey": ["exec"]
            }
        }
    }
}
